# Manual Route API v2 credentials.
#
# Copy this file to .env and fill in the values. .env is gitignored; this
# template is safe to commit, so never put real secrets in it.
#
#     cp .env-example .env
#
# Get the key/secret from app.industrialmatrix.com/profile -> API tab.
# (That tab is only visible to Plant Admin and IT users.)

# Your public API key.
IM_API_KEY=

# Your secret key. Keep this private.
IM_API_SECRET=

# Optional. Override the API root, e.g. for a staging environment.
# Defaults to https://api.pdmmatrix.assetmatrix.com when unset.
# IM_API_BASE=https://api.pdmmatrix.assetmatrix.com
